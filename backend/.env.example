# 本地默认 SQLite；生产填 Neon 的连接串
DATABASE_URL=<redacted>

# 生产必须设为 0（关掉验证码回显）
DEV_MODE=1

# 开发/测试验证码；生产换成随机值（或接真短信后此项作废）
DEV_TEST_CODE=123456

# 真短信（Twilio Verify API）：四项全填才发短信；不填且 DEV_MODE=1 时回退内存验证码
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 邮箱验证码（Resend HTTPS API）：填了才发邮件验证码；发件域名用 Resend 测试域 onboarding@resend.dev
# 免费版测试域只能发到 Resend 账号注册邮箱；要发给任意邮箱需在 Resend 验证自己的域名
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=onboarding@resend.dev

# 线上付款（Stripe）：填了才启用线上付款；去 https://dashboard.stripe.com/apikeys 拿
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
