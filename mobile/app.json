{
  "expo": {
    "name": "私人专车",
    "slug": "private-ride",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e0e0e",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0e0e"
    },
    "ios": {
      "bundleIdentifier": "com.haocoach.privateride",
      "supportsTablet": false,
      "buildNumber": "2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "接单后把你的位置分享给乘客，方便乘客知道你到哪了。 Your location is shared with the rider during a trip.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.haocoach.privateride",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e0e0e"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f2ca50"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "接单后把你的位置分享给乘客。 Your location is shared with the rider during a trip."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
